Module module() {
  return module(
    name: "orm.hibernate",
    version: 6,
    exports: ["Builder", "Provider", "Session", "Transaction"],
    dependencies: [dependency(repository: "github", name: "orm", version: 5)],
    binding: jarBinding(
      target: mavenJar(
        group: "org.hibernate.orm",
        artifact: "hibernate-core",
        version: "7.4.7.Final", resolution: sha256("677c6e052b112af791a08d1c5526371ec88ef0499fdc89a343414f52e18c0999")
      ),
      api: [
        jarType(
          name: "org.hibernate.cfg.Configuration", alias: "Builder", members: [],
          overloads: [
            jarOverload(name: "new", parameterTypes: []),
            jarOverload(name: "addAnnotatedClass", parameterTypes: ["java.lang.Class"]),
            jarOverload(name: "buildSessionFactory", parameterTypes: []),
            jarOverload(name: "setProperty", parameterTypes: ["java.lang.String", "java.lang.String"])
          ]
        ),
        jarType(
          name: "org.hibernate.SessionFactory", alias: "Provider", members: [],
          overloads: [
            jarOverload(name: "close", parameterTypes: []),
            jarOverload(name: "isOpen", parameterTypes: []),
            jarOverload(name: "openSession", parameterTypes: [])
          ]
        ),
        jarType(
          name: "org.hibernate.Session", alias: "Session", members: [],
          overloads: [
            jarOverload(name: "beginTransaction", parameterTypes: []),
            jarOverload(name: "close", parameterTypes: []),
            jarOverload(name: "find", parameterTypes: ["java.lang.Class", "java.lang.Object"]),
            jarOverload(name: "flush", parameterTypes: []),
            jarOverload(name: "persist", parameterTypes: ["java.lang.Object"]),
            jarOverload(name: "remove", parameterTypes: ["java.lang.Object"])
          ]
        ),
        jarType(
          name: "org.hibernate.Transaction", alias: "Transaction", members: [],
          overloads: [
            jarOverload(name: "commit", parameterTypes: []),
            jarOverload(name: "isActive", parameterTypes: []),
            jarOverload(name: "rollback", parameterTypes: [])
          ]
        )
      ]
    )
  )
}

